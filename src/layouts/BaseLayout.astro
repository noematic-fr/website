---
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/dm-sans/wght-italic.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import WatchNo from '../components/WatchNo.astro';
import { content } from '../content';
import { alternateUrl, canonicalPath, LANG_SWITCH } from '../i18n';
import { ANALYTICS_ENDPOINT, LOCALE, OG_IMAGE, SITE_NAME, SITE_URL } from '../site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title = content.meta.title,
  description = content.meta.description,
  ogImage = OG_IMAGE,
  jsonLd,
  noindex = false,
} = Astro.props;

const path = canonicalPath(Astro.url.pathname);
const canonical = new URL(path, SITE_URL).href;
const ogImageAbs = new URL(ogImage, SITE_URL).href;
const ogLocale = LOCALE === 'fr' ? 'fr_FR' : 'en_US';
const ogLocaleAlt = LOCALE === 'fr' ? 'en_US' : 'fr_FR';
const alternateHref = noindex ? null : alternateUrl(path);
const xDefault = alternateHref ? (LOCALE === 'en' ? canonical : alternateHref) : null;
const jsonLdRaw = jsonLd ? JSON.stringify(jsonLd) : null;
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={ogLocale} />
    {alternateHref && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    {alternateHref && xDefault && (
      <>
        <link rel="alternate" hreflang={LOCALE} href={canonical} />
        <link rel="alternate" hreflang={LANG_SWITCH.code} href={alternateHref} />
        <link rel="alternate" hreflang="x-default" href={xDefault} />
      </>
    )}
    {jsonLdRaw && <script type="application/ld+json" set:html={jsonLdRaw} />}
    <script data-goatcounter={ANALYTICS_ENDPOINT} async src="https://qi.noematic.eu/count.min.js"></script>
    <WatchNo />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
