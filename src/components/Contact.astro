---
import { content } from '../content';

const { contact } = content;
---

<section id="contact">
  <div class="noe-container">
    <h2>{contact.title}</h2>
    <div class="contact__info">
      <p class="contact__label">{contact.emailLabel}</p>
      <span>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </span>
      <p class="contact__label">{contact.addressLabel}</p>
      <span>{contact.address}</span>
      {contact.note && <p class="contact__note">{contact.note}</p>}
    </div>
  </div>
</section>