---
import { content } from '../content';

const { proof } = content;
---

<section id="proof" class="noe-section">
  <div class="noe-container">
    <header class="noe-section-header">
      <h2>{proof.title}</h2>
      <p class="noe-section-lead">{proof.subtitle}</p>
    </header>
    <div class="noe-card-grid noe-card-grid--products">
      {proof.items.map((item) => (
        <article class="noe-card">
          <div class="noe-card-top">
            <h3>{item.name}</h3>
          </div>
          <p class="noe-proof-role">{item.role}</p>
          <p>{item.body}</p>
          <ul class="noe-tags">
            {item.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
