---
import { content } from '../content';
---

<button
  type="button"
  class="noe-theme"
  data-theme-toggle
  data-label-system={content.footer.themeSystem}
  data-label-light={content.footer.themeLight}
  data-label-dark={content.footer.themeDark}
  data-prefix={content.footer.themePrefix}
  data-next-system={content.footer.themeNextSystem}
  data-next-light={content.footer.themeNextLight}
  data-next-dark={content.footer.themeNextDark}
  aria-label={`${content.footer.themePrefix} ${content.footer.themeSystem}. ${content.footer.themeNextLight}`}
>
  <svg class="noe-theme-icon noe-theme-icon--light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"
    ></path>
  </svg>
  <svg class="noe-theme-icon noe-theme-icon--dark" viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linejoin="round"
      d="M15.5 14.5A6.2 6.2 0 0 1 9.2 4.8 6.5 6.5 0 1 0 19 14.6a6.2 6.2 0 0 1-3.5-.1z"
    ></path>
  </svg>
  <span class="noe-theme-label" data-theme-label>{content.footer.themeSystem}</span>
</button>
<script is:inline>
  if (window.__noeThemeBind) window.__noeThemeBind();
</script>
